{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "yoru.spotlight-sweep-moves-glow-wake-sleep",
  "version": "0.1.0",
  "name": "聚光醒睡扫过 · Glow wake-sleep",
  "description": "黑场里一块斜置的界面截图面板从黑暗中醒来：一道带辉光的紫色光线贴着面板顶边从左匀速扫到右，光到哪里哪里亮，面板同时慢慢向右漂，光头接近右缘时右缘转蓝紫；片段最后 800ms 自己沉回黑暗（环境光降 0、贴边光淡出）。界面图填一张截图（界面、网页、App 都行），不填就画一块浅灰骨架占位面板，动作照常走完。底色、扫光紫、面板底色都能在检查器里改。透明模式下去掉黑底和雾光，就是一块带聚光的暗面板，可以叠在别的画面上。改编自 video-shotcraft 的 glow-wake-sleep-panel 镜头卡（Apache-2.0）。画面只取决于播放头位置，往回拖、重复渲染都是同一帧。",
  "author": {
    "name": "Yoru"
  },
  "main": "graphic.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": true,
  "stepCount": 1,
  "actionDurations": [
    {
      "type": "playAction",
      "duration": 4200
    },
    {
      "type": "updateAction",
      "duration": 0
    },
    {
      "type": "stopAction",
      "duration": 800
    }
  ],
  "schema": {
    "type": "object",
    "gddPlayoutOptions": {
      "client": {
        "duration": 5000
      }
    },
    "properties": {
      "panelImage": {
        "type": "string",
        "gddType": "file-path/image-path",
        "gddOptions": {
          "extensions": [
            "png",
            "jpg",
            "jpeg",
            "webp",
            "svg",
            "gif"
          ]
        },
        "title": "界面截图",
        "description": "斜置面板里放的截图（界面、网页、App），cover 裁切不拉伸；横竖都可以。不填就画一块浅灰骨架占位面板。 填图片的完整路径：在文件夹里选中图片，按 Ctrl+Shift+C 复制路径，粘贴进来。",
        "default": ""
      },
      "bgColor": {
        "type": "string",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$",
        "title": "底色",
        "description": "面板后面的黑场底色。",
        "default": "#040308"
      },
      "glowColor": {
        "type": "string",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$",
        "title": "扫光紫",
        "description": "贴顶边扫过的光带颜色；右缘蓝紫和光头亮芯都从它推出来。",
        "default": "#b478ff"
      },
      "panelColor": {
        "type": "string",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$",
        "title": "面板底色",
        "description": "没填截图时占位面板的浅灰底色，面板露出的底也用它。",
        "default": "#f6f6f5"
      },
      "transparent": {
        "type": "boolean",
        "title": "透明背景",
        "description": "勾上就去掉黑底和环境雾光，只留带聚光的暗面板（面板上的压暗罩照画），可以叠在别的画面上。",
        "default": false
      }
    }
  },
  "renderRequirements": [
    {
      "accessToPublicInternet": {
        "ideal": false
      }
    }
  ]
}
