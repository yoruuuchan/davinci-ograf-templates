{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "yoru.type-assembly-moves-drift-assembly",
  "version": "0.1.0",
  "name": "漂移合拢片名 · Drift assembly",
  "description": "一行大字，每个字从自己那条固定方向带着模糊、旋转和纵深漂回来，落定瞬间加深闪一下；全部落定后整词轻轻呼吸一次，字面下方浮出一层落地影。文字、颜色、字号都能在检查器里改，片段结尾统一上飘淡出。改编自 video-shotcraft 的 drift-assembly 镜头卡（Apache-2.0）。画面只取决于播放头位置，往回拖、重复渲染都是同一帧。",
  "author": {
    "name": "Yoru"
  },
  "main": "graphic.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": true,
  "stepCount": 1,
  "actionDurations": [
    {
      "type": "playAction",
      "duration": 4600
    },
    {
      "type": "updateAction",
      "duration": 0
    },
    {
      "type": "stopAction",
      "duration": 400
    }
  ],
  "schema": {
    "type": "object",
    "gddPlayoutOptions": {
      "client": {
        "duration": 5000
      }
    },
    "properties": {
      "title": {
        "type": "string",
        "gddType": "single-line",
        "title": "片名",
        "description": "一行大字，每个字从自己的方向漂回来。中文逐字、英文逐字符；超过 12 个字错峰会自动压紧，太长会整词缩小。想要横向片名的分量感可以填六到八个字。",
        "default": "光影工坊"
      },
      "paperColor": {
        "type": "string",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$",
        "title": "纸面颜色",
        "description": "背景的颜色。",
        "default": "#f6f2ea"
      },
      "inkColor": {
        "type": "string",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$",
        "title": "文字颜色",
        "description": "落定加深脉冲从这里压向纯黑。",
        "default": "#17181c"
      },
      "glowColor": {
        "type": "string",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$",
        "title": "背光颜色",
        "description": "背景里那抹极淡的色相余光。",
        "default": "#5b63d3"
      },
      "transparent": {
        "type": "boolean",
        "title": "透明背景",
        "description": "勾上就去掉背景，只留文字和图形，可以叠在别的画面上。",
        "default": false
      },
      "fontSize": {
        "type": "number",
        "title": "字号",
        "description": "按 1080 高的画面算，默认 148。字多了放不下时整词等比缩小；竖屏自动换算。",
        "default": 148,
        "minimum": 60,
        "maximum": 240
      },
      "fontPick": {
        "type": "string",
        "gddType": "select",
        "enum": [
          "内置",
          "微软雅黑",
          "宋体",
          "楷体",
          "仿宋",
          "黑体",
          "等线",
          "思源宋体"
        ],
        "gddOptions": {
          "labels": {
            "内置": "内置",
            "微软雅黑": "微软雅黑",
            "宋体": "宋体",
            "楷体": "楷体",
            "仿宋": "仿宋",
            "黑体": "黑体",
            "等线": "等线",
            "思源宋体": "思源宋体"
          }
        },
        "title": "字体预设",
        "description": "下拉选一个预设字体；下面的「字体」框里填了就以它为准。",
        "default": "内置"
      },
      "fontFamily": {
        "type": "string",
        "gddType": "single-line",
        "title": "字体",
        "description": "填字体名，比如 微软雅黑、楷体、思源宋体。留空用内置的思源黑体。要用的字体没装，把字体文件放进模板目录的 fonts 文件夹，填 fonts/文件名.ttf；直接填 C:\\Windows\\Fonts\\... 这种系统路径在达芬奇里不生效。",
        "default": ""
      }
    }
  },
  "renderRequirements": [
    {
      "accessToPublicInternet": {
        "ideal": false
      }
    }
  ]
}
