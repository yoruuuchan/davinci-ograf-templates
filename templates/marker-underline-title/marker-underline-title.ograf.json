{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "yoru.marker-underline-title",
  "version": "0.1.0",
  "name": "马克笔下划线标题 · Marker underline title",
  "description": "两行大标题错峰落定，关键词下面一笔马克笔线从左往右画出来。改编自 video-shotcraft 的 marker-underline-title 镜头卡（Apache-2.0）。画面只取决于播放头位置，往回拖、重复渲染都是同一帧。",
  "author": {
    "name": "Yoru"
  },
  "main": "graphic.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": true,
  "stepCount": 1,
  "actionDurations": [
    {
      "type": "playAction",
      "duration": 1400
    },
    {
      "type": "updateAction",
      "duration": 0
    },
    {
      "type": "stopAction",
      "duration": 400
    }
  ],
  "schema": {
    "type": "object",
    "properties": {
      "line1": {
        "type": "string",
        "gddType": "single-line",
        "title": "第一行",
        "default": "遇见全新的"
      },
      "line2": {
        "type": "string",
        "gddType": "single-line",
        "title": "第二行",
        "default": "动效模板"
      },
      "keyword": {
        "type": "string",
        "gddType": "single-line",
        "title": "划线的词（要在第一行或第二行里）",
        "default": "全新"
      },
      "icon": {
        "type": "string",
        "gddType": "file-path/image-path",
        "gddOptions": {
          "extensions": [
            "png",
            "jpg",
            "jpeg",
            "webp",
            "svg",
            "gif"
          ]
        },
        "title": "第二行前的图标（图片，可留空）",
        "default": ""
      },
      "textColor": {
        "type": "string",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$",
        "title": "文字颜色",
        "default": "#17181c"
      },
      "markerColor": {
        "type": "string",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$",
        "title": "马克笔颜色",
        "default": "#1b1916"
      },
      "background": {
        "type": "string",
        "gddType": "select",
        "enum": [
          "paper",
          "transparent"
        ],
        "gddOptions": {
          "labels": {
            "paper": "纸面",
            "transparent": "透明"
          }
        },
        "title": "背景：填 paper（纸面）或 transparent（透明）",
        "default": "paper"
      },
      "fontSize": {
        "type": "number",
        "title": "字号（按 1080 高的画面算，默认 118）",
        "default": 118,
        "minimum": 16,
        "maximum": 400
      },
      "fontFamily": {
        "type": "string",
        "gddType": "single-line",
        "title": "字体（留空用内置思源黑体，也可以填电脑里装好的字体名）",
        "default": ""
      },
      "italic": {
        "type": "boolean",
        "title": "关键词斜体",
        "default": false
      }
    }
  },
  "renderRequirements": [
    {
      "accessToPublicInternet": {
        "ideal": false
      }
    }
  ]
}
