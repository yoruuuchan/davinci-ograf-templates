{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "yoru.logo-shrink-wordmark-lockup",
  "version": "0.1.0",
  "name": "大环收束定版 · Ring shrink lockup",
  "description": "霓虹缺口大环旋转收束成中央标志，带冲击波和缩放残影，字标逐字滑入、标语整行淡入，完成标志定版。标志、字标、标语、颜色和字号都能在检查器里改；标志留空时保留愈合后的白色圆环。改编自 video-shotcraft 的 logo-shrink-wordmark-lockup 镜头卡（Apache-2.0）。画面只取决于播放头位置，往回拖、重复渲染都是同一帧。",
  "author": {
    "name": "Yoru"
  },
  "main": "graphic.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": true,
  "stepCount": 1,
  "actionDurations": [
    {
      "type": "playAction",
      "duration": 4600
    },
    {
      "type": "updateAction",
      "duration": 0
    },
    {
      "type": "stopAction",
      "duration": 400
    }
  ],
  "schema": {
    "type": "object",
    "gddPlayoutOptions": {
      "client": {
        "duration": 5000
      }
    },
    "properties": {
      "logo": {
        "type": "string",
        "gddType": "file-path/image-path",
        "gddOptions": {
          "extensions": [
            "png",
            "jpg",
            "jpeg",
            "webp",
            "svg",
            "gif"
          ]
        },
        "title": "标志",
        "description": "收束定版中央的标志，按原比例放进 120px 的方框，不跟着环旋转。 填图片的完整路径：在文件夹里选中图片，按 Ctrl+Shift+C 复制路径，粘贴进来。",
        "default": ""
      },
      "wordmark": {
        "type": "string",
        "gddType": "single-line",
        "title": "字标",
        "description": "标志右边的名字，从左到右逐字滑入。留空只显示标志。",
        "default": "拾光影像工作室"
      },
      "tagline": {
        "type": "string",
        "gddType": "single-line",
        "title": "标语",
        "description": "字标下面的一行小字，整行淡入。留空就不显示。",
        "default": "把每一帧，都拍成电影。"
      },
      "bgColor": {
        "type": "string",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$",
        "title": "背景颜色",
        "description": "深场的底色，上下渐变从它推出来。",
        "default": "#06070c"
      },
      "inkColor": {
        "type": "string",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$",
        "title": "文字颜色",
        "description": "字标和环芯的颜色。",
        "default": "#f3f5fb"
      },
      "accentColor": {
        "type": "string",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$",
        "title": "强调色",
        "description": "环的霓虹晕、标语、冲击波和字标微光的颜色。",
        "default": "#9d94ff"
      },
      "wordmarkSize": {
        "type": "number",
        "title": "字标字号",
        "description": "按 1080 高的画面算，默认 88；图标、间距和滑入距离跟着等比。",
        "default": 88,
        "minimum": 48,
        "maximum": 140
      },
      "smallScale": {
        "type": "number",
        "title": "小字倍率",
        "description": "小字（眉题、副标、说明、标注这类）的字号倍率，1 是原卡比例；觉得小字太小就调大。",
        "default": 1,
        "minimum": 0.6,
        "maximum": 2
      },
      "transparent": {
        "type": "boolean",
        "title": "透明背景",
        "description": "勾上就去掉背景，只留文字和图形，可以叠在别的画面上。",
        "default": false
      },
      "fontPick": {
        "type": "string",
        "gddType": "select",
        "enum": [
          "内置",
          "微软雅黑",
          "宋体",
          "楷体",
          "仿宋",
          "黑体",
          "等线",
          "思源宋体"
        ],
        "gddOptions": {
          "labels": {
            "内置": "内置",
            "微软雅黑": "微软雅黑",
            "宋体": "宋体",
            "楷体": "楷体",
            "仿宋": "仿宋",
            "黑体": "黑体",
            "等线": "等线",
            "思源宋体": "思源宋体"
          }
        },
        "title": "字体预设",
        "description": "下拉选一个预设字体；下面的「字体」框里填了就以它为准。",
        "default": "内置"
      },
      "fontFamily": {
        "type": "string",
        "gddType": "single-line",
        "title": "字体",
        "description": "填字体名，比如 微软雅黑、楷体、思源宋体。留空用内置的思源黑体。要用的字体没装，把字体文件放进模板目录的 fonts 文件夹，填 fonts/文件名.ttf；直接填 C:\\Windows\\Fonts\\... 这种系统路径在达芬奇里不生效。",
        "default": ""
      }
    }
  },
  "renderRequirements": [
    {
      "accessToPublicInternet": {
        "ideal": false
      }
    }
  ]
}
